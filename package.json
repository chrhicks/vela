{
  "name": "vela",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @vela/model build && pnpm --filter @vela/alpaca build && pnpm --parallel --filter @vela/model --filter @vela/alpaca --filter @vela/web --filter @vela/server dev",
    "dev:workshop": "pnpm --filter @vela/workshop dev",
    "dev:observing": "node scripts/dev-observing.mjs",
    "build": "pnpm -r --if-present run build",
    "dev:web": "pnpm --filter @vela/web dev",
    "dev:server": "pnpm --filter @vela/server dev",
    "test": "pnpm --filter @vela/model test:types && vitest run",
    "start": "pnpm --filter @vela/server start",
    "lint": "oxlint",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "oxlint": "1.82.0",
    "vitest": "^4.1.11"
  }
}
