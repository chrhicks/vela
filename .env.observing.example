# Copy to .env.observing.local. Paths are relative to the repository root.
VELA_LAN_HOST=polaris.local
VELA_ASTAP=apps/rig-simulator/.local/assets/astap_cli
VELA_STAR_CATALOG=apps/rig-simulator/.local/assets/catalog/opt/astap

# Physical alignment is deliberately configured for one rig's stable device IDs.
VELA_ALIGNMENT_MODE=physical
VELA_ALIGNMENT_ENDPOINT=http://YOUR-RIG-HOST:11111
VELA_ALIGNMENT_CAMERA_ID=YOUR-IMAGING-CAMERA-ID
VELA_ALIGNMENT_TELESCOPE_ID=YOUR-TELESCOPE-ID

# Optional local OpenTelemetry journal (one path per server). See docs/local-tracing.md.
# VELA_TRACE_PATH=data/traces/observing.jsonl
