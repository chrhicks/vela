{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/prove-http.ts", "src/prove-framing.ts"]
}
