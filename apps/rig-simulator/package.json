{
  "name": "@vela/rig-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.controls.json && vite build",
    "prove": "node --import tsx src/prove.ts",
    "dev:server": "node --import tsx src/server.ts",
    "dev:controls": "vite --host 127.0.0.1 --port 5177 --strictPort",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "dependencies": {
    "@vela/ui": "workspace:*",
    "fastify": "^5.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
